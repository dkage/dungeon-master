{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-markdown.sh\"",
            "timeout": 15,
            "statusMessage": "Formatting markdown"
          }
        ]
      }
    ]
  }
}
