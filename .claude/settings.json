{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-markdown.sh\"",
            "timeout": 15,
            "statusMessage": "Formatting markdown"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-broad-git-staging.py\"",
            "timeout": 10,
            "statusMessage": "Checking git staging"
          }
        ]
      }
    ]
  }
}
